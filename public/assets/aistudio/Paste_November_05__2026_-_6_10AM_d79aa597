// ==========================================
// 7. MASTER APP & ROUTING SWITCHER
// ==========================================
export default function App() {
  const [activePortal, setActivePortal] = useState('landing'); // 'landing' | 'patient-directory' | 'patient' | 'reception' | 'doctor'
  const [tenants, setTenants] = useState(INITIAL_SAAS_TENANTS);
  const [activeTenantId, setActiveTenantId] = useState(INITIAL_SAAS_TENANTS[0].id);
  const [isAuthModalOpen, setIsAuthModalOpen] = useState(false);

  const activeTenant = tenants.find(t => t.id === activeTenantId) || tenants[0];

  return (
    <div className="relative min-h-screen">
      
      {/* Floating SASS Onboarding & Switcher Widget ("عيادتي حالاً") */}
      <div className="fixed bottom-4 left-4 z-[95] bg-[#001d2d]/95 text-white p-2 rounded-2xl shadow-2xl border border-white/20 backdrop-blur-md flex items-center gap-2 text-xs">
        <div className="w-8 h-8 rounded-xl bg-white p-1 flex items-center justify-center shrink-0">
          <img src={SAAS_LOGO_URL} alt="Logo" className="w-full h-full object-contain" />
        </div>
        
        <button
          onClick={() => setIsAuthModalOpen(true)}
          className="px-3.5 py-2 rounded-xl font-bold bg-[#F40E31] text-white shadow-md hover:bg-[#d00c28] transition-all flex items-center gap-1.5"
        >
          <Sparkles size={14} />
          <span>Sign up / Sign in (SASS)</span>
        </button>

        <div className="h-5 w-px bg-white/20"></div>

        <button
          onClick={() => setActivePortal('landing')}
          className={`px-3 py-1.5 rounded-lg font-semibold transition-all ${activePortal === 'landing' ? 'bg-white text-[#002F49]' : 'text-white/70 hover:text-white'}`}
        >
          Home
        </button>
        <button
          onClick={() => setActivePortal('patient-directory')}
          className={`px-3 py-1.5 rounded-lg font-semibold transition-all ${activePortal === 'patient-directory' ? 'bg-[#15679D] text-white' : 'text-white/70 hover:text-white'}`}
        >
          Patients (اختر تخصص)
        </button>
      </div>

      {/* SaaS Auth & Onboarding Modal */}
      <SaasAuthModal
        isOpen={isAuthModalOpen}
        onClose={() => setIsAuthModalOpen(false)}
        onRegisterDoctor={(newDoc) => {
          setTenants(prev => [newDoc, ...prev]);
          setActiveTenantId(newDoc.id);
          setActivePortal('landing');
        }}
        onRegisterReceptionist={() => {
          setActivePortal('reception');
        }}
        onSelectPatientView={() => {
          setActivePortal('patient-directory');
        }}
      />

      {/* Portal Routing */}
      {activePortal === 'landing' && (
        <LandingPortal 
          tenant={activeTenant}
          onSelectPortal={(role) => setActivePortal(role)} 
          onOpenSaasModal={() => setIsAuthModalOpen(true)}
        />
      )}
      {activePortal === 'patient-directory' && (
        <PatientDirectoryView
          tenants={tenants}
          onSelectTenant={(doc) => {
            setActiveTenantId(doc.id);
            setActivePortal('landing');
          }}
          onBackToHome={() => setActivePortal('landing')}
        />
      )}
      {activePortal === 'patient' && (
        <PatientPortal 
          tenant={activeTenant}
          onBackToHome={() => setActivePortal('landing')} 
        />
      )}
      {activePortal === 'reception' && (
        <ReceptionPortal 
          tenant={activeTenant}
          onBackToHome={() => setActivePortal('landing')} 
        />
      )}
      {activePortal === 'doctor' && (
        <DoctorPortal 
          tenant={activeTenant}
          onBackToHome={() => setActivePortal('landing')} 
        />
      )}

    </div>
  );
}