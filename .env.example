# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (fill with your Firebase Console credentials)
VITE_FIREBASE_API_KEY="AIzaSyPlaceholderKeyForDevelopmentOnly"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# WhatsApp Cloud API (Meta Graph API)
# Get these from Meta for Developers -> WhatsApp -> API Setup:
# - WHATSAPP_ACCESS_TOKEN: System User or Permanent Access Token with whatsapp_business_messaging permission
# - WHATSAPP_PHONE_NUMBER_ID: Phone number ID from WhatsApp API Setup (not the display phone number)
# - WHATSAPP_VERIFY_TOKEN: Custom string you create to verify the webhook in Meta App Dashboard
WHATSAPP_ACCESS_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="100000000000000"
WHATSAPP_VERIFY_TOKEN="my_custom_clinic_verify_token_123"

