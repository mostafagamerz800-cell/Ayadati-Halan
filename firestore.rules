rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Primitive Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. User Entity Validation Blueprint
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'department']) &&
             data.keys().hasOnly(['uid', 'email', 'name', 'role', 'department', 'photoURL', 'createdAt', 'updatedAt']) &&
             data.uid is string && isValidId(data.uid) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.role in ['doctor', 'receptionist', 'patient', 'admin'] &&
             data.department is string && data.department.size() > 0 && data.department.size() <= 100 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    // 3. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 4. Test connection probe doc for bootstrap checks
    match /test/connection {
      allow read: if true;
    }

    // 5. Users Collection
    match /users/{userId} {
      // Any signed-in user can read profiles for directory, queue, and staff lookup
      allow get, list: if isSignedIn();

      // Only the authenticated user can create their own document with strict validation
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().uid == userId &&
                       isValidUser(incoming());

      // Only the owner can update their document; uid cannot be modified
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().uid == existing().uid &&
                       isValidUser(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'department', 'photoURL', 'updatedAt']);

      // Only the owner can delete their profile
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 6. Medical Clinic Data Collections (Appointments, Patients, Queues)
    match /clinics/{clinicId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /{subCollection=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /appointments/{appointmentId} {
      allow read, write: if isSignedIn();
    }

    match /patients/{patientId} {
      allow read, write: if isSignedIn();
    }
  }
}
